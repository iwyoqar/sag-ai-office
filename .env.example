# Copy to .env and fill in. Never commit .env.

# --- server ---
PORT=4000
HOST=127.0.0.1
# SQLite file (dev). Relative to the repo root.
DATABASE_PATH=data/sag.db
SESSION_TTL_HOURS=168
# true behind HTTPS in production
COOKIE_SECURE=false
# Proxies allowed to set X-Forwarded-For (client IP for login throttling and audit). Empty = none (direct access).
# A hop count ("1" behind Render's load balancer) or comma-separated IPs/CIDRs. Never trust every sender.
TRUSTED_PROXIES=
LOG_LEVEL=info

# Initial admin password, used only on the very first start (empty DB).
# If empty, a random one is generated and printed once in the server log.
ADMIN_PASSWORD=

# --- Telegram (Phase 7) ---
# Bot token from @BotFather. Server-side only; never commit, never log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=-1004352159538
# Comma-separated Telegram user ids allowed to run privileged commands.
TELEGRAM_ADMIN_USER_IDS=
# polling (default, works locally) | webhook (production: Telegram pushes to POST /api/telegram/webhook)
TELEGRAM_MODE=polling
# Webhook mode only: public HTTPS base URL of this API, and a random secret (>= 16 chars, A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# --- AI provider (agents) ---
# gemini (default) | mock (test double, labelled "MOCK" in the UI — never real work)
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey  — server-side only.
# Note: on the free tier Google may use prompts to improve its products; do not send confidential data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Semantic search over The Brain documents (empty = full-text search only)
EMBEDDING_MODEL=gemini-embedding-001
# Spacing between AI requests (free tier ≈ 10 requests/minute)
LLM_MIN_INTERVAL_MS=6500
# Cost estimate in USD per 1M tokens (0 = free tier)
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
TASK_TIMEOUT_MS=120000

# --- Claude API (later, same provider interface) ---
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=

# --- Connectors: agent actions (The Brain → Connectorlar). Write actions always need a person's approval. ---
# Public URL of the web app (Google OAuth redirect: <PUBLIC_URL>/api/connectors/google/callback)
PUBLIC_URL=http://localhost:5173
# 32-byte key, base64, encrypts OAuth refresh tokens stored in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
# Google Workspace (Gmail, Drive, Sheets, Calendar): OAuth client from Google Cloud Console (type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional instead of the in-app "Google bilan ulash" button:
# GOOGLE_REFRESH_TOKEN=
# Slack bot token (xoxb-…), scopes: chat:write, channels:read
SLACK_BOT_TOKEN=
# Notion internal integration token; share the target pages with the integration
NOTION_TOKEN=

# --- Off-site backups (W0) — off until BACKUP_TARGET is set; see docs/DEPLOY.md §6 ---
# s3 = any S3-compatible storage the owner chose (AWS S3, Cloudflare R2, Backblaze B2, MinIO); dir = another disk/volume
BACKUP_TARGET=
# 32 random bytes, base64 (openssl rand -base64 32). Keep a copy offline: without it no backup can be restored.
BACKUP_KEY=
BACKUP_KEY_ID=k1
# previous keys for restoring older backups after a rotation: k0:<base64>,...
BACKUP_OLD_KEYS=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_DIR=
BACKUP_PREFIX=sag-ai-office/
BACKUP_INTERVAL_MINUTES=60
BACKUP_RETAIN_HOURLY=48
BACKUP_RETAIN_DAILY=30
BACKUP_RETAIN_MONTHLY=12
